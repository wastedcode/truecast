{
  "name": "@wastedcode/truecast",
  "version": "0.3.0",
  "description": "Install and run portable, versioned expert personas in Claude Code.",
  "license": "MIT",
  "author": "Inder Singh <inder@wastedcode.com>",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wastedcode/truecast.git"
  },
  "homepage": "https://truecast.dev",
  "bugs": {
    "url": "https://github.com/wastedcode/truecast/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "subagent",
    "persona",
    "agent",
    "ai",
    "prompt",
    "cli"
  ],
  "bin": {
    "truecast": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "execa": "^10.1.1",
    "is-path-inside": "^4.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.8.5",
    "simple-git": "^4.0.2",
    "smol-toml": "^1.9.1",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
